{
  "name": "agent-monitor-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Monitor - Chrome DevTools / Activity Monitor for AI Agents",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "dev:web": "npm run dev --workspace=apps/web",
    "cli": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
