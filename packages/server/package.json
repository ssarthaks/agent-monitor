{
  "name": "@agent-monitor/server",
  "version": "0.1.4",
  "description": "SQLite WAL persistence and real-time SSE streaming server for Agent Monitor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
