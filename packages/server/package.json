  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist public"
  },
  "dependencies": {
    "@agent-monitor/core": "^0.1.4",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
